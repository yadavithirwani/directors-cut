# AETHER Ops / Glass Box - Live Production Environment Configuration

# -----------------------------------------------------------------------------
# 1. GRAFANA CLOUD MCP CONFIGURATION
# -----------------------------------------------------------------------------
# Your Grafana Cloud Stack URL (e.g., https://your-stack-name.grafana.net)
GRAFANA_URL=https://your-stack-name.grafana.net

# Grafana Cloud Service Account Token or API Key with read permissions
GRAFANA_API_KEY=your_grafana_service_account_token_here

# Grafana Cloud MCP Endpoint (Default: https://mcp.grafana.com/mcp)
GRAFANA_MCP_ENDPOINT=https://mcp.grafana.com/mcp


# -----------------------------------------------------------------------------
# 2. PARALLEL WEB SEARCH API CONFIGURATION
# -----------------------------------------------------------------------------
# API Key from Parallel Web (https://parallel.ai)
PARALLEL_API_KEY=your_parallel_api_key_here

# Parallel Search API Base URL
PARALLEL_API_ENDPOINT=https://api.parallel.ai/v1/search


# -----------------------------------------------------------------------------
# 3. CLICKHOUSE CLOUD CONFIGURATION
# -----------------------------------------------------------------------------
# ClickHouse Host (e.g., xyz.us-east-1.aws.clickhouse.cloud)
CLICKHOUSE_HOST=your_clickhouse_host_here
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_clickhouse_password_here
CLICKHOUSE_DATABASE=default

# -----------------------------------------------------------------------------
# 4. GEMINI API KEY (For LLM Triage & Judge synthesis)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
